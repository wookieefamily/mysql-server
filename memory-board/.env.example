# Copy this file to .env.local for local development, and set the same values
# as environment variables in Netlify for production.

# Your Google Calendar API key (from Google Cloud Console). Restrict it to the
# Calendar API and to your site's domain so it cannot be reused elsewhere.
VITE_GOOGLE_CALENDAR_API_KEY=your-api-key-here

# The "Mom's Day" calendar ID. Optional: the app already defaults to this one.
VITE_CALENDAR_ID=1fb0675288d513a41a8097ab193d5f7601a439080ca5be6998be87dfd4f7963b@group.calendar.google.com
